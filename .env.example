# Copy this file to .env for local reference. Export values in your shell before starting services.
# Default is a local SQLite file. PostgreSQL is optional for development.
DATABASE_URL=sqlite:///./virtual_store.db
CORS_ORIGINS=http://localhost:3000
ADMIN_API_KEY=replace-this-with-a-long-random-local-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
